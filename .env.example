# === Database (MySQL) ===
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASS=your_mysql_password
MYSQL_DB=your_database_name

# === YouTube API ===
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_PLAYLIST_ID=your_youtube_playlist_id_here

# === NextAuth (Keycloak) ===
NEXTAUTH_URL=http://localhost:3000
# WAJIB di production. Buat nilai acak dengan: openssl rand -hex 32
NEXTAUTH_SECRET=your_nextauth_secret_here
KEYCLOAK_CLIENT_ID=your_client_id
KEYCLOAK_CLIENT_SECRET=your_client_secret
KEYCLOAK_ISSUER=https://your-keycloak-server/realms/your-realm

# === Public URLs (client-side) ===
# PERINGATAN: apa pun yang diawali NEXT_PUBLIC_ ikut ter-bundle ke browser.
# JANGAN pernah menaruh secret/token di variabel NEXT_PUBLIC_*.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_POM_URL=https://your-pom-domain.example
NEXT_PUBLIC_BERITA_API_URL=https://your-berita-domain.example/path/scrape-berita.php
NEXT_PUBLIC_RB_URL=https://your-rb-subdomain.example

# === Login (Basic Auth) ===
LOGIN_USER=your_admin_username
LOGIN_PASS=your_strong_password
